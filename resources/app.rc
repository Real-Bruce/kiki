// Keep ID 1 as the first icon group for Windows Explorer and shortcuts.
1 ICON "resources/icons/kiki.ico"

1 VERSIONINFO
 FILEVERSION KIKI_VERSION_NUMBERS
 PRODUCTVERSION KIKI_VERSION_NUMBERS
 FILEOS 0x00040004L
 FILETYPE 0x00000001L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "FileDescription", "kiki"
            VALUE "FileVersion", KIKI_VERSION_STRING
            VALUE "OriginalFilename", "kiki.exe"
            VALUE "ProductName", "kiki"
            VALUE "ProductVersion", KIKI_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
